<elementProp name="ThreadGroup.main_controller" elementType="LoopController" testclass="LoopController"><stringProp name="LoopController.loops">1</stringProp></elementProp>
<stringProp name="ThreadGroup.num_threads">1</stringProp><stringProp name="ThreadGroup.ramp_time">0</stringProp><boolProp name="ThreadGroup.scheduler">false</boolProp><stringProp name="ThreadGroup.duration"></stringProp></ThreadGroup>
<hashTree>
<CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="Backslash Delimited"><stringProp name="filename">odd.csv</stringProp><stringProp name="variableNames">a\b</stringProp><stringProp name="delimiter">\</stringProp><boolProp name="ignoreFirstLine">true</boolProp></CSVDataSet>
